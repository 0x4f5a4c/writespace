# APPLICATION

PORT=8000
NODE_ENV=development

CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8000/api/v1

SHUTDOWN_TIMEOUT_MS=120000
TRUST_PROXY_HOPS=0


# DOCKER DEVELOPMENT

HOST_PORT=8000

POSTGRES_DB=writespace
POSTGRES_USER=writespace
POSTGRES_PASSWORD=writespace_dev_password
POSTGRES_HOST_PORT=5433

REDIS_HOST_PORT=6380

# POSTGRESQL

# Host connections to the PostgreSQL container.
# Docker Compose overrides these with the internal postgres service address.
DATABASE_URL=postgresql://writespace_app:password@127.0.0.1:6432/writespace

# Direct connection for Drizzle migrations.
DATABASE_DIRECT_URL=postgresql://writespace_migrator:password@127.0.0.1:5432/writespace

# Application-side PostgreSQL connection pool configuration.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000


# REDIS

# Host connections to the Redis container.
# Docker Compose overrides this with redis:6379.
REDIS_URL=redis://localhost:6380

# Optional Redis password
# REDIS_PASSWORD=redis_password

REDIS_CONNECT_TIMEOUT_MS=10000


# BULLMQ / BACKGROUND WORKERS

# Worker concurrency
EMAIL_WORKER_CONCURRENCY=5
MEDIA_WORKER_CONCURRENCY=5
NOTIFICATION_WORKER_CONCURRENCY=10

# Queue retry attempts
EMAIL_QUEUE_ATTEMPTS=3
MEDIA_QUEUE_ATTEMPTS=3
NOTIFICATION_QUEUE_ATTEMPTS=2

# Notification delivery reconciliation
NOTIFICATION_RECONCILIATION_INTERVAL_MS=15000
NOTIFICATION_RECONCILIATION_BATCH_SIZE=25
NOTIFICATION_RECONCILIATION_LEASE_DURATION_MS=30000
NOTIFICATION_RECONCILIATION_MAX_ATTEMPTS=5
NOTIFICATION_RECONCILIATION_INITIAL_GRACE_PERIOD_MS=30000
NOTIFICATION_RECONCILIATION_RETRY_DELAY_MS=60000

# DURABLE NOTIFICATION EVENT PIPELINE
# Enable the transactional outbox notification pipeline.
# Leave false until the outbox/processed-events migration has been applied
# to the target PostgreSQL database. Setting this to true before migrations
# will cause the dispatcher worker to fail on every poll.
OUTBOX_PROCESSING_ENABLED=false

# How frequently the outbox dispatcher checks PostgreSQL for pending events
OUTBOX_DISPATCHER_POLL_INTERVAL_MS=1000

# Maximum number of outbox events claimed in one batch
# Min: 1, Max: 250
OUTBOX_DISPATCHER_BATCH_SIZE=25

# Lease duration for claimed outbox events.
# If a dispatcher crashes, another instance can reclaim the event after
# this lease expires.
OUTBOX_DISPATCHER_LEASE_DURATION_MS=60000

# Maximum dispatch attempts before an event moves to FAILED
# Min: 1, Max: 50
OUTBOX_DISPATCHER_MAX_ATTEMPTS=10

# Exponential retry backoff for the outbox-to-BullMQ handoff.
# OUTBOX_DISPATCHER_BACKOFF_MAX_MS must be >= OUTBOX_DISPATCHER_BACKOFF_BASE_MS
# (enforced by env.ts refine).
OUTBOX_DISPATCHER_BACKOFF_BASE_MS=1000
OUTBOX_DISPATCHER_BACKOFF_MAX_MS=60000

# Lease duration for an individual notification channel delivery.
# The delivery worker renews this lease while its handler is running.
NOTIFICATION_DELIVERY_LEASE_DURATION_MS=60000

# Shared retry backoff delay
QUEUE_BACKOFF_DELAY_MS=1000


# RATE LIMITING

# General API: IP-based
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=300

# Login: IP-based
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=10

# Login: email-based
LOGIN_EMAIL_RATE_LIMIT_WINDOW_MS=900000
LOGIN_EMAIL_RATE_LIMIT_MAX_REQUESTS=5

# Registration: IP-based
REGISTER_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_RATE_LIMIT_MAX_REQUESTS=10

# Registration: email-based
REGISTER_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
REGISTER_EMAIL_RATE_LIMIT_MAX_REQUESTS=3

# Email verification: IP-based
EMAIL_VERIFICATION_RATE_LIMIT_WINDOW_MS=900000
EMAIL_VERIFICATION_RATE_LIMIT_MAX_REQUESTS=10

# Email verification: email-based
EMAIL_VERIFICATION_EMAIL_RATE_LIMIT_WINDOW_MS=600000
EMAIL_VERIFICATION_EMAIL_RATE_LIMIT_MAX_REQUESTS=5

# Forgot password: IP-based
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_RATE_LIMIT_MAX_REQUESTS=5

# Forgot password: email-based
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_WINDOW_MS=3600000
FORGOT_PASSWORD_EMAIL_RATE_LIMIT_MAX_REQUESTS=3

# Reset password: IP-based
RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
RESET_PASSWORD_RATE_LIMIT_MAX_REQUESTS=10


# AUTHENTICATION

JWT_ACCESS_SECRET=jwt_access_secret
JWT_REFRESH_SECRET=jwt_refresh_secret

JWT_ACCESS_EXPIRE=15m

# SESSION LIFETIME
SESSION_IDLE_TIMEOUT_SECONDS=604800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=2592000

# Generate with: openssl rand -hex 32
AUTH_CHALLENGE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


# CLOUDINARY

CLOUDINARY_CLOUD_NAME=cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# UPLOAD LIMITS

MAX_FILE_SIZE_MB=5
MAX_FILES_PER_UPLOAD=12


# SMTP / EMAIL

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USER=username@gmail.com
SMTP_PASS=password_app_google

# SMTP CONNECTION TIMEOUTS

SMTP_CONNECTION_TIMEOUT_MS=30000
SMTP_GREETING_TIMEOUT_MS=15000
SMTP_SOCKET_TIMEOUT_MS=60000


# OAUTH

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret


# AI CONFIGURATION
# Note: AI is not documented in v1 (see modules/ai.md stub).
# Leave AI_ENABLED=false unless you/I are actively developing the AI module.
# When AI_ENABLED=true, BOTH AI_MODEL and GEMINI_API_KEY become required
# (validated at startup by src/config/env.ts).

AI_ENABLED=false

# Available providers: gemini, mock
AI_PROVIDER=gemini

# Required only when AI_ENABLED=true
# AI_MODEL=gemini-2.0-flash-lite
# GEMINI_API_KEY=your_gemini_api_key

AI_TIMEOUT_MS=60000
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=1000
AI_MAX_RETRIES=2